# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/hooked

# ── Flask / JWT ────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=your-secret-key-here

# ── Frontend URL (used for CORS + OAuth redirect) ──────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Replicate (hosted MusicGen inference) ──────────────────────────────────────
REPLICATE_API_TOKEN=your-replicate-api-token

# ── Cloudinary (profile picture uploads) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email / SMTP (verification + password reset emails) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Hooked
