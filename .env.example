# Database
DATABASE_URL=postgresql://postgres:12345@localhost:5432/hooked

# Spotify (optional, for future features)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your-secret-key-here

# Frontend and Backend URLs
# Local Development (default values)
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:5000

# Production (Render)
# FRONTEND_URL=https://hooked-frontend.onrender.com
# REACT_APP_API_URL=https://hooked-backend.onrender.com

# Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://hooked-frontend.onrender.com
